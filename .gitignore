# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
.next/
out/
.turbo/
*.tsbuildinfo

# Environment — never commit secrets
.env
.env.*
!.env.example

# Runtime data (user uploads, generated files) — also the per-service
# storage dirs DiskBlobStore creates when a service runs from its own cwd
storage/**
**/storage/**
!storage/**/.gitkeep
logs/
*.log

# Prisma
database/prisma/*.db
database/prisma/generated/

# Python (ai/ modules)
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Testing
coverage/
.nyc_output/
playwright-report/
test-results/

# IDE / editor
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Terraform
infrastructure/terraform/.terraform/
infrastructure/terraform/*.tfstate
infrastructure/terraform/*.tfstate.backup
infrastructure/terraform/*.tfvars

# Archives and build packages
*.zip
*.tar.gz
*.tgz

# Generated visual reports and temporary media
reports/


