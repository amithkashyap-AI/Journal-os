# Copy to .env and adjust. Never commit .env.

NODE_ENV=development

# Database (matches docker-compose.yml)
# Port 5433 to avoid clashing with a natively installed Postgres on 5432
DATABASE_URL=postgresql://rpos:rpos_dev_password@localhost:5433/rpos?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Services
AUTH_PORT=4001
SUBMISSION_PORT=4002
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1h

# Logging
LOG_LEVEL=info
