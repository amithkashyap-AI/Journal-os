# Copy to .env and adjust. Never commit .env.

NODE_ENV=development

# Database (matches docker-compose.yml)
# Port 5433 to avoid clashing with a natively installed Postgres on 5432
DATABASE_URL=postgresql://rpos:rpos_dev_password@localhost:5433/rpos?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Service ports are PREFERENCES, not hard assignments: if the port is already
# in use, the service automatically binds the next free port and logs it.
# Leave unset to use the defaults shown here.
GATEWAY_PORT=4000
AUTH_PORT=4001
SUBMISSION_PORT=4002
REVIEW_PORT=4003
NOTIFICATION_PORT=4004
JOURNAL_PORT=4005
FILE_STORAGE_PORT=4006
AI_PORT=4007

# Where uploaded manuscripts are written on disk
STORAGE_DIR=storage/manuscripts

# DOI registrant prefix assigned to a published submission (10.5555 is the
# DOI Foundation's reserved test prefix; swap for your real one in production)
DOI_PREFIX=10.5555

# Shared secret for service-to-service calls (e.g. emitting notifications)
INTERNAL_API_SECRET=change-me-internal-secret
# Where submission/review services send notification events (omit to disable)
NOTIFICATION_API_URL=http://localhost:4004

# Local Ollama instance backing the AI service's keyword/abstract assist
# (run `ollama serve` + `ollama pull <model>`; falls back to a clean
# "unavailable" response if unreachable, never a fake suggestion)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen

# Web app port (Next.js honours PORT; dev mode also auto-increments if busy)
# PORT=3000
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1h

# Web app (server-side URLs of the backing services)
AUTH_API_URL=http://localhost:4001
SUBMISSION_API_URL=http://localhost:4002
REVIEW_API_URL=http://localhost:4003
JOURNAL_API_URL=http://localhost:4005
FILE_API_URL=http://localhost:4006
AI_API_URL=http://localhost:4007

# API gateway (public entry point, proxies /api/* to the services)
RATE_LIMIT_MAX=300
# CORS_ORIGINS=https://app.example.org,https://admin.example.org

# Logging
LOG_LEVEL=info
