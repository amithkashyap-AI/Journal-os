generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  PUBLISHER
  EDITOR
  REVIEWER
  AUTHOR
  READER
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  REVISIONS_REQUESTED
  ACCEPTED
  REJECTED
  PUBLISHED
  WITHDRAWN
}

enum ReviewRecommendation {
  ACCEPT
  MINOR_REVISION
  MAJOR_REVISION
  REJECT
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  roles        UserRole[] @default([AUTHOR])
  affiliation  String?
  orcid        String?    @unique
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  submissions     Submission[]
  reviews         Review[]
  notifications   Notification[]
  ownedPublishers Publisher[]

  @@map("users")
}

model Publisher {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  website   String?
  ownerId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner       User?        @relation(fields: [ownerId], references: [id])
  journals    Journal[]
  conferences Conference[]
  books       Book[]
  apiKey      ApiKey?

  @@index([ownerId])
  @@map("publishers")
}

model ApiKey {
  id          String    @id @default(cuid())
  publisherId String    @unique
  key         String    @unique
  enabled     Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastUsedAt  DateTime?

  publisher Publisher @relation(fields: [publisherId], references: [id], onDelete: Cascade)

  @@index([key])
  @@map("api_keys")
}

model Journal {
  id          String   @id @default(cuid())
  publisherId String
  title       String
  slug        String   @unique
  issn        String?  @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  publisher   Publisher    @relation(fields: [publisherId], references: [id])
  submissions Submission[]

  @@map("journals")
}

model Conference {
  id          String   @id @default(cuid())
  publisherId String
  title       String
  slug        String   @unique
  location    String?
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  publisher Publisher @relation(fields: [publisherId], references: [id])

  @@map("conferences")
}

model Book {
  id          String   @id @default(cuid())
  publisherId String
  title       String
  slug        String   @unique
  isbn        String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  publisher Publisher @relation(fields: [publisherId], references: [id])

  @@map("books")
}

model Submission {
  id            String           @id @default(cuid())
  journalId     String
  authorId      String
  title         String
  abstract      String
  keywords      String[]
  status        SubmissionStatus @default(DRAFT)
  manuscriptUrl String?
  doi           String?          @unique
  submittedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  journal Journal  @relation(fields: [journalId], references: [id])
  author  User     @relation(fields: [authorId], references: [id])
  reviews Review[]

  @@index([journalId, status])
  @@map("submissions")
}

model Review {
  id             String                @id @default(cuid())
  submissionId   String
  reviewerId     String
  recommendation ReviewRecommendation?
  comments       String?
  dueAt          DateTime?
  submittedAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  submission Submission @relation(fields: [submissionId], references: [id])
  reviewer   User       @relation(fields: [reviewerId], references: [id])

  @@unique([submissionId, reviewerId])
  @@map("reviews")
}

model FileObject {
  id        String   @id @default(cuid())
  ownerId   String
  filename  String
  mimeType  String
  size      Int
  path      String
  createdAt DateTime @default(now())

  @@index([ownerId])
  @@map("files")
}

model Notification {
  id        String             @id @default(cuid())
  userId    String
  type      String
  subject   String
  body      String
  status    NotificationStatus @default(PENDING)
  error     String?
  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime           @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@map("notifications")
}
