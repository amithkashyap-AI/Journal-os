generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPERADMIN
  ADMIN
  PUBLISHER
  EDITOR
  REVIEWER
  AUTHOR
  READER
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  REVISIONS_REQUESTED
  ACCEPTED
  REJECTED
  PUBLISHED
  WITHDRAWN
}

enum ReviewRecommendation {
  ACCEPT
  MINOR_REVISION
  MAJOR_REVISION
  REJECT
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  active       Boolean    @default(true)
  roles        UserRole[] @default([AUTHOR])
  affiliation  String?
  orcid        String?    @unique
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  submissions      Submission[]
  reviews          Review[]
  notifications    Notification[]
  ownedPublishers  Publisher[]
  publisherMember  PublisherMember[]
  customRoles      UserCustomRole[]
  journalAssignments JournalEditorAssignment[]

  @@map("users")
}

/// A named role an Admin can define, with its own permission set — additive
/// to the fixed UserRole enum, not a replacement. System rows (isSystem)
/// mirror the 7 UserRole enum values for display/documentation only; the
/// enum remains the actual mechanism for those base roles. Only isSystem=false
/// rows are ever assignable via UserCustomRole.
model Role {
  id            String   @id @default(cuid())
  key           String   @unique
  name          String
  description   String?
  isSystem      Boolean  @default(false)
  createdByUserId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  permissions RolePermission[]
  users       UserCustomRole[]

  @@map("roles")
}

model Permission {
  id          String @id @default(cuid())
  key         String @unique
  description String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Assignment of a custom (isSystem=false) Role to a user — additive to
/// their base UserRole[] array, never a replacement for it.
model UserCustomRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_custom_roles")
}

model Publisher {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  website   String?
  ownerId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner       User?              @relation(fields: [ownerId], references: [id])
  journals    Journal[]
  conferences Conference[]
  books       Book[]
  apiKey      ApiKey?
  members     PublisherMember[]
  workflowActionRules WorkflowActionRule[]

  @@index([ownerId])
  @@map("publishers")
}

/// Tenant-scoped editorial staff: which publisher a user's EDITOR/REVIEWER
/// capability actually applies to. Without this, any global EDITOR/REVIEWER
/// could see or act on every publisher's submissions — the opposite of
/// tenant isolation. Publisher.ownerId already scopes the PUBLISHER role the
/// same way; this closes the equivalent gap for EDITOR and REVIEWER.
model PublisherMember {
  id          String   @id @default(cuid())
  publisherId String
  userId      String
  role        UserRole
  createdAt   DateTime @default(now())

  publisher Publisher @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([publisherId, userId, role])
  @@index([userId])
  @@map("publisher_members")
}

model ApiKey {
  id          String    @id @default(cuid())
  publisherId String    @unique
  key         String    @unique
  enabled     Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastUsedAt  DateTime?

  publisher Publisher @relation(fields: [publisherId], references: [id], onDelete: Cascade)

  @@index([key])
  @@map("api_keys")
}

model Journal {
  id          String   @id @default(cuid())
  publisherId String
  title       String
  slug        String   @unique
  issn        String?  @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  publisher   Publisher    @relation(fields: [publisherId], references: [id])
  submissions Submission[]
  editors JournalEditorAssignment[]
  indexing JournalIndexingEvidence[]
  assessment JournalAssessment?
  publicationProfile JournalPublicationProfile?

  @@index([publisherId])
  @@map("journals")
}

/// Per-tenant override of which roles may perform a given workflow action
/// within this publisher's journals — additive/replacing on top of
/// @rpos/workflow-engine's fixed default role list for that action. The
/// action set and state graph stay fixed platform-wide; only WHO may act
/// is tenant-configurable. ADMIN/SUPERADMIN always bypass regardless of
/// what's configured here (enforced in applyTransition, not stored).
model WorkflowActionRule {
  id          String     @id @default(cuid())
  publisherId String
  action      String
  roles       UserRole[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  publisher Publisher @relation(fields: [publisherId], references: [id], onDelete: Cascade)

  @@unique([publisherId, action])
  @@map("workflow_action_rules")
}

model Conference {
  id          String   @id @default(cuid())
  publisherId String
  title       String
  slug        String   @unique
  location    String?
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  publisher Publisher @relation(fields: [publisherId], references: [id])

  @@map("conferences")
}

model Book {
  id          String   @id @default(cuid())
  publisherId String
  title       String
  slug        String   @unique
  isbn        String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  publisher Publisher @relation(fields: [publisherId], references: [id])

  @@map("books")
}

model Submission {
  id            String           @id @default(cuid())
  journalId     String
  authorId      String
  title         String
  abstract      String
  keywords      String[]
  status        SubmissionStatus @default(DRAFT)
  manuscriptUrl String?
  doi           String?          @unique
  submittedAt   DateTime?
  publishedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  journal Journal  @relation(fields: [journalId], references: [id])
  author  User     @relation(fields: [authorId], references: [id])
  reviews Review[]

  @@index([journalId, status])
  @@index([status, publishedAt])
  @@index([authorId, createdAt(sort: Desc)])
  @@map("submissions")
}

model Review {
  id             String                @id @default(cuid())
  submissionId   String
  reviewerId     String
  round          Int                   @default(1)
  recommendation ReviewRecommendation?
  comments       String?
  dueAt          DateTime?
  submittedAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  submission Submission @relation(fields: [submissionId], references: [id])
  reviewer   User       @relation(fields: [reviewerId], references: [id])

  @@unique([submissionId, reviewerId, round])
  @@index([reviewerId, submittedAt])
  @@map("reviews")
}

model FileObject {
  id        String   @id @default(cuid())
  ownerId   String
  filename  String
  mimeType  String
  size      Int
  path      String
  createdAt DateTime @default(now())

  @@index([ownerId])
  @@map("files")
}

model Notification {
  id        String             @id @default(cuid())
  userId    String
  type      String
  subject   String
  body      String
  status    NotificationStatus @default(PENDING)
  error     String?
  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime           @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@map("notifications")
}

model JournalEditorAssignment {
  journalId String
  userId String
  createdAt DateTime @default(now())
  journal Journal @relation(fields: [journalId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([journalId, userId])
  @@index([userId])
  @@map("journal_editor_assignments")
}

model JournalIndexingEvidence {
  journalId String
  source String
  status String
  quartile String?
  indexYear Int?
  subjectCategory String?
  coverageStartYear Int?
  coverageEndYear Int?
  sourceUrl String
  checkedAt DateTime
  notes String
  verifiedBy String
  updatedAt DateTime @updatedAt
  journal Journal @relation(fields: [journalId], references: [id], onDelete: Cascade)
  @@id([journalId, source])
  @@map("journal_indexing_evidence")
}

model JournalAssessment {
  journalId String @id
  text String
  model String
  evidenceHash String
  generatedAt DateTime @default(now())
  journal Journal @relation(fields: [journalId], references: [id], onDelete: Cascade)
  @@map("journal_assessments")
}

model JournalPublicationProfile {
  journalId String @id
  categories String[]
  feeModel String
  accessModel String
  publicationWeeks Int?
  sourceUrl String
  checkedAt DateTime
  notes String
  verifiedBy String
  journal Journal @relation(fields: [journalId], references: [id], onDelete: Cascade)
  @@map("journal_publication_profiles")
}
